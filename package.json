{
  "name": "fa-mcp-sdk",
  "productName": "FA MCP SDK",
  "version": "0.12.142",
  "description": "Core infrastructure and templates for building Model Context Protocol (MCP) servers with TypeScript",
  "type": "module",
  "main": "dist/core/index.js",
  "types": "dist/core/index.d.ts",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist/core/**/*",
    ".agents/skills/deploy-new-project/**/*",
    "cli-template/**/*",
    "cli-template/.gitignore",
    "bin/**/*",
    "config/default.yaml",
    "config/development.yaml",
    "config/production.yaml",
    "config/test.yaml",
    "config/custom-environment-variables.yaml",
    "config/_local.yaml",
    "src/template/**/*",
    "src/tests/**/*",
    "scripts/**/*",
    "README.md"
  ],
  "bin": {
    "fa-mcp": "bin/fa-mcp.js",
    "fa-mcp-sdk": "bin/fa-mcp.js"
  },
  "scripts": {
    "start": "npm run template:start",
    "build": "tsc && npm run copy-static",
    "copy-static": "node scripts/copy-static.js",
    "clean": "rimraf dist",
    "cb": "npm run clean && npm run build",
    "dev": "tsc --watch",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "quality": "npm run lint && npm run format",
    "quality:fix": "npm run lint:fix && npm run format:fix",
    "lint-fix-build": "oxlint --fix . && oxfmt . && rimraf dist && tsc && node scripts/copy-static.js",
    "ci": "node --no-deprecation ./scripts/npm/run.js",
    "reinstall": "node --no-deprecation ./scripts/npm/run.js reinstall",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run cb",
    "template:start": "node dist/template/start.js",
    "template:stdio": "node dist/template/start.js stdio",
    "token-gen": "node dist/core/auth/token-generator/server.js",
    "prepare": "node scripts/claude-2-agents-symlink.js setup",
    "test:skills-layout": "node --test tests/skills-layout.test.mjs",
    "agents:link": "node scripts/claude-2-agents-symlink.js setup",
    "agents:link:status": "node scripts/claude-2-agents-symlink.js status",
    "agents:link:remove": "node scripts/claude-2-agents-symlink.js remove",
    "tsoa:spec": "tsoa spec",
    "check-llm": "node dist/core/agent-tester/check-llm.js",
    "test:ip-check": "npm run build && node tests/ip-check.test.mjs",
    "test:jwt": "npm run build && node tests/jwt.test.mjs",
    "test:jwt-v2": "npm run build && node tests/jwt-v2.test.mjs",
    "test:on-behalf-of": "npm run build && node tests/on-behalf-of.test.mjs",
    "test:oauth-endpoints": "npm run build && node tests/oauth-endpoints.test.mjs",
    "test:agent-tester-modes": "npm run build && node tests/agent-tester-auth-modes.test.mjs",
    "test:agent-tester-ttl": "npm run build && node tests/agent-tester-ttl-refresh.test.mjs",
    "test:capabilities": "npm run build && node tests/capabilities.test.mjs",
    "test:error-sanitize": "npm run build && node tests/error-sanitize.test.mjs",
    "test:binary-resource": "npm run build && node tests/binary-resource.test.mjs",
    "test:error-codes": "npm run build && node tests/error-codes.test.mjs",
    "test:completions": "npm run build && node tests/completions.test.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "typescript",
    "server",
    "framework",
    "template",
    "claude",
    "ai",
    "api",
    "prompts",
    "tools",
    "resources"
  ],
  "author": {
    "name": "Viacheslav Makarov",
    "email": "npmjs@bazilio.ru"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bazilio-san/fa-mcp-sdk.git"
  },
  "homepage": "https://github.com/Bazilio-san/fa-mcp-sdk#readme",
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@tsoa/runtime": "^6.6.0",
    "af-ad-ts": "^0.0.71",
    "af-db-ts": "^3.0.34",
    "af-logger-ts": "^0.0.26",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "chalk": "^6.0.1",
    "config": "^5.0.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "fa-consul": "^1.0.7",
    "helmet": "^8.3.0",
    "jose": "^6.2.15",
    "js-yaml": "^5.5.0",
    "jsonwebtoken": "^9.0.3",
    "node-cache": "^5.1.2",
    "openai": "^7.53.0",
    "pgvector": "^0.3.1",
    "prom-client": "^15.1.3",
    "rate-limiter-flexible": "^11.3.0",
    "swagger-ui-express": "^5.0.1",
    "tsoa": "^6.6.0",
    "uuid": "^14.0.3",
    "ya-express-ntlm": "^1.0.39",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tsoa/cli": "^6.6.0",
    "@types/config": "^4.4.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.6.6",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript/typescript6": "^6.0.2",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "rimraf": "^6.1.4",
    "typescript": "^7.0.2"
  }
}
